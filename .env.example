# --- Authentication ---
# Auth.js v5 secret (generate: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (optional — set BOTH values or leave BOTH blank to disable
# Google sign-in).
# console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payments (Razorpay, test mode) ---
# Dashboard -> Settings -> API Keys. Key ID is safe for the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks: Dashboard -> Settings -> Webhooks -> add endpoint /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend, optional — mail is skipped when unset) ---
RESEND_API_KEY=
# Sender for transactional order email. Required to enable order emails; use
# `Vendary <onboarding@resend.dev>` until your domain is verified in Resend.
# (Local `next dev` falls back to onboarding@resend.dev when this is blank;
# production and e2e skip sending instead.)
EMAIL_FROM=
# Optional store inbox that receives a copy of every order email.
ORDER_NOTIFICATION_EMAIL=

# --- Database ---
DATABASE_URL=

# --- Redis (optional; cache disabled when absent or blank) ---
REDIS_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Invoicing ---
# Seller GSTIN printed on order invoices. Leave blank to omit the row (e.g.
# before GST registration); the rest of the invoice still renders.
SELLER_GSTIN=

# --- Runtime validation ---
# Set to 1 to skip the production env assertion. Intended only for CI/Docker
# builds that pass placeholder values; never set it on a real deployment.
SKIP_ENV_VALIDATION=
