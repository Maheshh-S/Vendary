# --- Authentication ---
# Auth.js v5 secret (generate: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client ID (Web))
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payments (Razorpay, test mode) ---
# Dashboard -> Settings -> API Keys. Key ID is safe for the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks: Dashboard -> Settings -> Webhooks -> add endpoint /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Database ---
DATABASE_URL=

# --- Redis (optional; cache disabled when absent) ---
REDIS_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000
