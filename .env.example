# --- Authentication ---
# Auth.js v5 secret (generate: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (optional — set BOTH values or leave BOTH blank to disable
# Google sign-in).
# console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payments (Razorpay, test mode) ---
# Dashboard -> Settings -> API Keys. Key ID is safe for the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks: Dashboard -> Settings -> Webhooks -> add endpoint /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend, optional — mail is skipped when unset) ---
RESEND_API_KEY=

# --- Database ---
DATABASE_URL=

# --- Redis (optional; cache disabled when absent or blank) ---
REDIS_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Runtime validation ---
# Set to 1 to skip the production env assertion. Intended only for CI/Docker
# builds that pass placeholder values; never set it on a real deployment.
SKIP_ENV_VALIDATION=
